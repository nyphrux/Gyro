<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Foreground-only location for the speedometer (GPS Doppler speed) and, optionally,
        a one-off coarse fix for magnetic declination (true north) and the sun marker. Android 12+ requires
        FINE to be requested together with COARSE so the user can pick precision.
        No background location. Sensor and location data never leave the device.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        In-app updates. The network is only used when the update button in Settings is tapped:
        it asks GitHub for the latest release and, if you choose to, downloads its APK, which is
        handed to the system installer.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The speed alert buzzes even when touch feedback is off. Normal permission: granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Sensors are optional so the app still installs on hardware lacking some of them;
         each tool reports missing hardware explicitly at runtime. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".GyroApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Gyro"
        tools:targetApi="36">

        <!--
            Portrait on phones: an instrument whose UI flips at 45° while you are measuring tilt
            is unusable. Large screens may ignore this (Android 16+), so all sensor maths still
            reads the live display rotation.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press launcher shortcuts to Compass, Speed and Tilt. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Shares the downloaded update APK (app cache only) with the system package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
