<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: the device-only store never leaves this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/gyro_device.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/gyro_device.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
